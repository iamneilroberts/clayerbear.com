{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clayerbear",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // The website itself: everything in /public is served as-is.
  // /api/*, /img/*, /theme.css, /figure/*, /sitemap.xml and /robots.txt run the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*", "/theme.css", "/figure/*", "/sitemap.xml", "/robots.txt"]
  },

  // Once a day: renew the Instagram token so it never expires.
  "triggers": { "crons": ["17 9 * * *"] },

  // Figures, orders, requests and settings. After `npx wrangler d1 create clayerbear`,
  // paste the database_id it prints here.
  "d1_databases": [
    { "binding": "DB", "database_name": "clayerbear", "database_id": "575f096d-2b89-4957-8c25-0aaefcc63225" }
  ],

  // Figure photos, logo and font uploads, and photos customers attach to requests.
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "clayerbear-photos" }
  ],

  "vars": {
    "SHOW_SAMPLES": "false",   // "true" shows the sample figures while the shelf is empty
    "NOTIFY_FROM": "request@clayerbear.com"
  },

  // Email Claire when a request comes in, from request@clayerbear.com. Needs
  // Email Routing on for clayerbear.com with her address verified there.
  // NOTIFY_TO (her inbox) is a secret so it stays out of this public repo.
  "send_email": [{ "name": "NOTIFY" }],

  "routes": [
    { "pattern": "clayerbear.com", "custom_domain": true },
    { "pattern": "www.clayerbear.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }

  // Secrets (set with `npx wrangler secret put NAME`, never written here):
  //   ADMIN_PASSWORD          password for /admin
  //   STRIPE_SECRET_KEY       turns on card checkout (see README)
  //   STRIPE_WEBHOOK_SECRET   lets Stripe tell the site a payment went through
  //   IG_ACCESS_TOKEN         lets the admin page post to Instagram (see README)
  //   NOTIFY_TO               inbox that gets request emails
}
